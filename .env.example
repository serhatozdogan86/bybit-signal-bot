# --- Bybit (public endpoints; MVP'de key KULLANILMAZ, ileride emir icin rezerve) ---
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Telegram (zorunlu) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tarama ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HTF=240
LTF=15
SCAN_INTERVAL=900

# --- Strateji esikleri ---
RISK_REWARD_MIN=2.0
ADX_CHOP=20
VOLUME_MULT=1.5
PIVOT_LOOKBACK=3
ATR_STOP_MULT=1.2

# --- Davranis ---
SEND_NO_TRADE=false
SEND_DATA_MISSING=false
SIGNAL_COOLDOWN_SEC=14400
LOG_LEVEL=INFO
