# --- Bybit (public endpoints; MVP'de key KULLANILMAZ, ileride emir icin rezerve) ---
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Telegram (zorunlu) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tarama ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HTF=240
LTF=15
SCAN_INTERVAL=900

# --- Strateji esikleri ---
RISK_REWARD_MIN=2.0
ADX_CHOP=20
VOLUME_MULT=1.5
PIVOT_LOOKBACK=3
ATR_STOP_MULT=1.2

# --- Davranis ---
SEND_NO_TRADE=false
SEND_DATA_MISSING=false
SIGNAL_COOLDOWN_SEC=14400
LOG_LEVEL=INFO

# --- Phase 2: kalicilik & golge takip ---
DB_PATH=data/bot.db
STATE_BACKEND=sqlite
SHADOW_TRACKING=true
SHADOW_FILL_WINDOW_BARS=24
SHADOW_MAX_TRACK_BARS=192

# --- Phase 2: zenginlestirme & format ---
ORDERBOOK_ENRICH=false
USE_WEBSOCKET=false
TELEGRAM_PARSE_MODE=

# --- Phase 2: gist yedekleme (botun kendi kayit tutmasi) ---
# Token: github.com -> Settings -> Developer settings -> PAT (classic) -> SADECE 'gist' scope
GITHUB_TOKEN=
GIST_SYNC=true
GIST_ID=
GIST_SYNC_INTERVAL_SEC=3600

# --- Evren secimi (v2.2) ---
# top: Bybit 24s hacim siralamasindan ilk N USDT perp, gunluk yenilenir
# static: SYMBOLS listesi aynen kullanilir
SYMBOLS_MODE=top
SYMBOLS_TOP_N=150
SYMBOLS_EXCLUDE=USDCUSDT,USDEUSDT,FDUSDUSDT
UNIVERSE_REFRESH_SEC=86400
SYMBOL_PAUSE_SEC=0.3
GIST_CANDLE_MODE=signals
GIST_CANDLE_MAX_ROWS=5000

# --- v2.3: sessiz mod & dashboard ---
# false: hicbir Telegram mesaji gitmez; sinyaller dashboard'da ("/") izlenir
TELEGRAM_ENABLED=false

# --- v2.5: dashboard yorum/market/haber ---
# COMMENT_INTERVAL_SEC=3600
# NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
