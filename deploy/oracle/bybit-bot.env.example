# /etc/bybit-bot.env  -- Render'daki degerlerin kopyasi (chmod 600!)
TELEGRAM_ENABLED=false
SYMBOLS_MODE=top
SYMBOLS_TOP_N=150
SYMBOL_PAUSE_SEC=0.3
HTF=240
LTF=15
SCAN_INTERVAL=900
RISK_REWARD_MIN=2.0
SEND_NO_TRADE=false
LOG_LEVEL=INFO
SHADOW_TRACKING=true
STATE_BACKEND=sqlite
DB_PATH=/opt/bybit-signal-bot/data/bot.db
GIST_SYNC=true
# Render panelinden kopyala (gist yazma yetkili token):
GITHUB_TOKEN=BURAYA_YAPISTIR
PORT=8080
